# Set these to use the Spring API. Leave both unset for the explicit browser SIMULATION adapter.
VITE_AEGIS_API_URL=http://localhost:8080
VITE_AEGIS_BASIC_AUTH=operator:operator-demo-only
# A browser-restricted Google Maps key is optional. Without it, the local visual map adapter is used.
VITE_GOOGLE_MAPS_BROWSER_KEY=
