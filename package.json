{
  "name": "aegis-connected-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts frontend --host 0.0.0.0",
    "build": "npm run build --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "test": ".venv/bin/python -m pytest -q",
    "lint": "eslint frontend/src src/map/TrackingMap.tsx && .venv/bin/ruff check backend --select E9,F63,F7,F82",
    "test:connected": "node tests/connected-flow.cjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "eslint": "^10.12.0",
    "typescript-eslint": "^8.71.1"
  }
}
