# Copy to .env and fill in locally. Do not commit .env.

# PostgreSQL 16 + PostGIS (profile local-pg)
DB_URL=jdbc:postgresql://localhost:5432/aegis
DB_USER=aegis
DB_PASSWORD=
POSTGRES_PASSWORD=

# Spring
SPRING_PROFILES_ACTIVE=local-pg

# Auth and inbound-call webhook. Leave empty only for labelled demo adapters.
JWT_SECRET=
WEBHOOK_HMAC_SECRET=

# AI advisory service
AI_SERVICE_URL=http://localhost:8000/api/v1

# Redis is optional and is not the source of truth. Default off.
AEGIS_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional map provider. When unset, the control room uses Leaflet.
GOOGLE_MAPS_API_KEY=
