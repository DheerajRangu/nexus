# Copy to .env for Docker Compose. Never commit real credentials.
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=change-me-locally
AEGIS_OPERATOR_PASSWORD=change-me-operator
AEGIS_DRIVER_PASSWORD=change-me-driver
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Development adapter. Synthetic missions only. Not the AEGIS mission database.
ADAPTER_MODE=development
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8787

# Set ADAPTER_MODE=proxy and the Spring Boot origin to forward the citizen contract.
# The adapter will not invent missions if that origin is down.
AEGIS_BACKEND_BASE_URL=
# Set true behind HTTPS so the session cookie is Secure.
COOKIE_SECURE=false
# Public numbers only. The driver action is a control-room relay.
PUBLIC_CONTROL_ROOM_PHONE=108
PUBLIC_DRIVER_RELAY_PHONE=108
# Restricted browser key for the Maps JavaScript API.
# Restrict by HTTP referrer to your site origin. Do not use a server key.
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_BASE=/api/v1/citizen
