# Local development; omit DATABASE_URL to use SQLite.
# DATABASE_URL=postgresql+psycopg://aegis:change_me@localhost:5432/aegis
# REDIS_URL=redis://localhost:6379/0
# USE_CELERY=1
# INFERENCE_DEVICE=cpu
# VEHICLE_MODEL=models/yolo26n.pt
# CORS_ORIGINS=http://localhost:5173
# AEGIS_API_KEY=optional-for-server-clients
POSTGRES_PASSWORD=aegis_local
# Live vision selects CUDA, then Apple MPS, then CPU automatically.
# Optional operator-configured RTSP/IP-camera URL or server webcam index:
# AEGIS_CAMERA_SOURCE=rtsp://user:password@camera-host/stream
