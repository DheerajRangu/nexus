# FastAPI is the shared authority. Local default uses SQLite.
AEGIS_DEMO_MODE=true
AEGIS_OPERATOR_KEY=
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# DATABASE_URL=postgresql+psycopg://aegis:aegis_local@localhost:5432/aegis
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=aegis_local
# Set in frontend/.env.local; browser key restricted by HTTP referrer.
VITE_GOOGLE_MAPS_API_KEY=
# Vite proxy origin (server-only).
AEGIS_API_ORIGIN=http://127.0.0.1:8000
# Optional live camera source; never configure a private stream in browser code.
# AEGIS_CAMERA_SOURCE=rtsp://camera-host/stream
# INFERENCE_DEVICE=cpu
# AEGIS_API_KEY=
# Optional citizen-interface settings.  The default API base is the Vite proxy.
VITE_API_BASE=/api/v1/citizen
VITE_WHATSAPP_LANDING_URL=https://wa.me/
