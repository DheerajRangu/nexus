# Copy to .env and fill in locally. Do not commit .env.

# PostgreSQL 16 + PostGIS (profile local-pg)
DB_URL=jdbc:postgresql://localhost:5432/aegis
DB_USER=aegis_app
DB_PASSWORD=
POSTGRES_PASSWORD=

# Spring
# Use local-pg,demo for live demo endpoints (/api/v1/demo/*) and DemoUserSeeder.
SPRING_PROFILES_ACTIVE=local-pg,demo

# Auth and inbound-call webhook. Leave empty only for labelled demo adapters.
JWT_SECRET=
WEBHOOK_HMAC_SECRET=

# AI advisory service
AI_SERVICE_URL=http://localhost:8000/api/v1

# Redis is optional and is not the source of truth. Default off.
AEGIS_REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379

# Optional Google Routes integration. Keep the key private; never place it in frontend variables.
# In Google Cloud, enable Routes API, enable billing, and restrict this key to Routes API.
# Leave the provider as demo until GOOGLE_MAPS_API_KEY is set.
AEGIS_ROUTING_PROVIDER=demo
GOOGLE_MAPS_API_KEY=
